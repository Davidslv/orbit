<h1>Subscriptions</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>User</th>
      <th>Plan</th>
      <th>Status</th>
      <th>Started</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @subscriptions.each do |subscription| %>
      <tr>
        <td><%= subscription.id %></td>
        <td><%= subscription.user_id %></td>
        <td><%= subscription.plan.name %></td>
        <td><%= subscription.status %></td>
        <td><%= subscription.started_at %></td>
        <td><%= link_to "View", subscription %></td>
      </tr>
    <% end %>
  </tbody>
</table>
